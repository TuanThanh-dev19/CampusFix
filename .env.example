# PostgreSQL used by compose.yaml and the Spring Boot backend
POSTGRES_DB=campusfix
POSTGRES_USER=campusfix
POSTGRES_PASSWORD=campusfix_local
DB_URL=jdbc:postgresql://localhost:5432/campusfix
DB_USERNAME=campusfix
DB_PASSWORD=campusfix_local

# Local-only JWT key. Replace it in every deployed environment.
JWT_SECRET=change-this-local-development-secret-32bytes

# Frontend
VITE_API_BASE_URL=/api/v1
